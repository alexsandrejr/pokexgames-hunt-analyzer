rust/app/src-tauri/gen/

# Pacote gerado pelo rust/tools/build_exe.mjs (e os antigos, do Python)
dist/
build/

# Ambiente virtual do Python antigo, se ainda existir na sua cópia
.venv/

# Editores
.vscode/
.idea/

# Variáveis de ambiente
.env

# Bancos de dados locais
*.db
*.sqlite
*.sqlite3

# Sistema operacional
Thumbs.db
Desktop.ini
.DS_Store

# Dados locais (banco, configurações, logs e backups)
data/

# JSONs importados/colados pelo usuário (dados pessoais); só o exemplo vai para o repositório
imports/*
!imports/exemplo_hunt_1080.json
